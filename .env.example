# Copy to .env.local. Generate independent random passwords; never commit it.
POSTGRES_USER=coupon_dev
POSTGRES_DB=coupon_development
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=
# Disposable PostgreSQL service, restricted coupon_test role, coupon_integration DB.
TEST_POSTGRES_PORT=55433
TEST_POSTGRES_PASSWORD=
TEST_DATABASE_URL=
# postgresql://coupon_test:<URL-encoded-test-password>@localhost:55433/coupon_integration
# Optional local fallback is DATABASE_URL. Required separate DDL role on deployed hosts.
MIGRATION_DATABASE_URL=
# Phase 2 conditional source: leave empty until the documented permissions exist.
# A token alone does not enable the disabled registry entry.
AMAZON_SP_API_ACCESS_TOKEN=
AMAZON_ELECTRONICS_ASINS=
# Development only; production returns 404 for previews regardless of this flag.
ENABLE_UI_PREVIEW=0

# Keep 0 until hosting, publication and privacy checks are complete.
PUBLIC_INDEXING_ENABLED=0

# Production saved-offer fallback is on by default; set 0 to disable.
PUBLIC_CATALOGUE_SNAPSHOT=1

# Visible advertising; production only, loads by default when in view.
# Build-time flag: set 0 and redeploy to remove all ad UI and frame endpoints.
NEXT_PUBLIC_ADS_ENABLED=1

# Optional independent public HTTPS host for native ad documents.
# Vercel defaults to its generated VERCEL_URL deployment origin.
# Must not be getpaid.co.in or its subdomains; must serve this app publicly.
NATIVE_AD_FRAME_ORIGIN=
